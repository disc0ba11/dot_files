/* rofi/powermenu.rasi — GENERATED by `hwe theme` from "Frost". DO NOT EDIT.
   The session menu (hwe power, SUPER+SHIFT+E): a compact vertical list that
   recolours with the active theme. Regenerate: hwe theme apply <name> */

* {
    bg-dark:      #0d1117;
    bg-normal:    #151b26;
    bg-light:     #1c2333;
    fg-dim:       #697a8c;
    fg-bright:    #e5eaf0;
    accent:       #88c0d0;
    urgent:       #bf616a;
    transparent:  #00000000;

    font: "GeistMono Nerd Font, JetBrains Mono, Symbols Nerd Font Mono 12";
    background-color: @transparent;
    text-color: @fg-bright;
}

window {
    location:         center;
    anchor:           center;
    width:            300px;
    border:           2px;
    border-color:     @accent;
    border-radius:    16px;   /* tracks the theme's window rounding */
    background-color: @bg-dark;
}

mainbox {
    spacing:          0px;
    children:         [ "message", "listview" ];
    background-color: @bg-dark;
    padding:          14px;
}

message {
    padding:          6px 10px 12px 10px;
    background-color: @transparent;
}

textbox {
    text-color:       @fg-dim;
    background-color: @transparent;
    horizontal-align: 0.5;
}

listview {
    lines:            5;
    columns:          1;
    scrollbar:        false;
    spacing:          4px;
    background-color: @transparent;
}

element {
    padding:          10px 14px;
    border-radius:    10px;
    background-color: @bg-normal;
    text-color:       @fg-bright;
    cursor:           pointer;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg-dark;
}

element-text {
    horizontal-align: 0.0;
    background-color: @transparent;
    text-color:       inherit;
}
