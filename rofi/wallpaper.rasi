/* rofi/wallpaper.rasi — GENERATED by `hwe theme` from "Frost". DO NOT EDIT.
   The wallpaper picker (hwe wall pick, SUPER+SHIFT+W): a tiled grid of thumbnails
   that recolours with the active theme. Regenerate: hwe theme apply <name> */

* {
    bg-dark:      #0d1117;
    bg-normal:    #151b26;
    bg-light:     #1c2333;
    fg-dim:       #697a8c;
    fg-bright:    #e5eaf0;
    fg-white:     #f0f4f8;
    accent:       #88c0d0;
    accent-soft:  #5eb7ce;
    transparent:  #00000000;

    font: "GeistMono Nerd Font, JetBrains Mono, Symbols Nerd Font Mono 10";
    background-color: @transparent;
    text-color: @fg-bright;
}

window {
    location:         center;
    anchor:           center;
    width:            900px;
    border:           2px;
    border-color:     @accent;
    border-radius:    16px;   /* tracks the theme's window rounding */
    background-color: @bg-dark;
    transparency:     "real";
}

mainbox {
    spacing:          0px;
    children:         [ "message", "listview" ];
    background-color: @bg-dark;
    padding:          16px;
}

message {
    padding:          8px 12px 16px 12px;
    background-color: @transparent;
}

textbox {
    text-color:       @accent-soft;
    background-color: @transparent;
    horizontal-align: 0.5;
}

listview {
    lines:            2;
    columns:          3;
    fixed-height:     false;
    spacing:          12px;
    scrollbar:        false;
    background-color: @transparent;
    dynamic:          true;
    cycle:            true;
}

element {
    orientation:      vertical;
    padding:          8px;
    spacing:          6px;
    border-radius:    10px;
    background-color: @bg-normal;
    text-color:       @fg-dim;
    cursor:           pointer;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg-dark;
    border:           2px;
    border-color:     @accent-soft;
}

element-icon {
    size:             200px;
    horizontal-align: 0.5;
    cursor:           inherit;
    background-color: @transparent;
    border-radius:    6px;
}

element-text {
    horizontal-align: 0.5;
    cursor:           inherit;
    background-color: @transparent;
    text-color:       inherit;
    font:             "GeistMono Nerd Font, JetBrains Mono, Symbols Nerd Font Mono 9";
}
