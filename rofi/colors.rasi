/* rofi/colors.rasi — GENERATED by `hwe theme` from "Frost". DO NOT EDIT.
   config.rasi does @import "colors.rasi" and uses @accent / @bg / … */

* {
    bg-dark: #0d1117;
    bg:      #151b26;
    bg-alt:  #1c2333;
    fg:      #e5eaf0;
    fg-dim:  #697a8c;
    accent:  #88c0d0;
    urgent:  #bf616a;

    /* Default rofi font from the [font] contract (launcher base + 2). config.rasi
       imports this and doesn't set its own font, so the launcher inherits it. */
    font: "GeistMono Nerd Font, JetBrains Mono, Symbols Nerd Font Mono 13";
}
