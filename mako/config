font=GeistMono Nerd Font, JetBrains Mono, Symbols Nerd Font Mono 11
width=360
height=120
margin=10
padding=14
border-size=1
border-radius=10
# icon-radius=8
max-icon-size=48
default-timeout=11000
ignore-timeout=1

background-color=#151b26
text-color=#e5eaf0
border-color=#88c0d0
progress-color=over #1c2333

[urgency=low]
border-color=#81a1c1

[urgency=high]
border-color=#bf616a
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category

# Правило для Пачки (она шлет уведомления как Pachca)
[app-name=Pachca]
on-button-left=exec ~/.config/zsh/focus-window pachca

# Правило для Telegram (обычно шлет как TelegramDesktop)
[app-name=TelegramDesktop]
on-button-left=exec ~/.config/zsh/focus-window telegram

# На случай если имя в D-Bus передается строчными
[app-name=telegramdesktop]
on-button-left=exec ~/.config/zsh/focus-window telegram

# Правило для Firefox
[app-name=firefox]
on-button-left=exec ~/.config/zsh/focus-window firefox

# Правило для Яндекс.Музыки
[app-name=YandexMusic]
on-button-left=exec ~/.config/zsh/focus-window music

[app-name="Yandex Music Liker"]
on-button-left=exec ~/.config/zsh/focus-window music